# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Секрет подписи JWT, не короче 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Время жизни токена
JWT_TTL=12h

# Часовой пояс для «сегодня» в прогрессе
APP_TIME_ZONE=Europe/Moscow

# Откуда фронту можно ходить в API
CORS_ALLOWED_ORIGINS=http://localhost:*

# Максимальный размер PDF
MAX_UPLOAD_SIZE=20MB

# stub — без сети; anthropic — Anthropic API; cli — локальный claude или codex CLI
AI_PROVIDER=cli
AI_MODEL=claude-opus-5
AI_CLI=codex
AI_CLI_MODEL=gpt-5.6-luna
AI_CLI_TIMEOUT_SECONDS=180
# Повтор запроса на запасной модели, если основная отказалась отвечать
AI_REFUSAL_FALLBACK=true
# Нужен только при AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
